# ── 飞书应用凭证（必填） ──
# 在飞书开放平台 -> 应用 -> 凭证与基础信息 中获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 飞书事件订阅（必填） ──
# 在飞书开放平台 -> 应用 -> 事件订阅 中获取
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx

# ── 可选配置 ──
PORT=8080
# 在 https://dashboard.ngrok.com/get-started/your-authtoken 获取
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx
SKILL_DIR=../.claude/skills/sales-tracker
NO_PROXY=*
